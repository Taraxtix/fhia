-------------------------------------------------
let x: i64 = (z: i64)
let y: i64 = (x: i64)
let z: i64 = (42)
let main: i32 = (i32 (y: i64))
-------------------------------------------------
; ModuleID = 'main'
source_filename = "main"

@x = global i64 0
@y = global i64 0
@z = global i64 0

define i32 @main() {
entry:
  store i64 42, ptr @z, align 8
  %z = load i64, ptr @z, align 8
  store i64 %z, ptr @x, align 8
  %x = load i64, ptr @x, align 8
  store i64 %x, ptr @y, align 8
  %y = load i64, ptr @y, align 8
  %trunc = trunc i64 %y to i32
  ret i32 %trunc
}
Return code: 42
