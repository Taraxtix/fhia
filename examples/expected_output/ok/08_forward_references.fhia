; ModuleID = 'main'
source_filename = "main"

@x = constant i64 42
@y = constant i64 42

define i32 @main() {
entry:
  %x = load i64, ptr @x, align 8
  %trunc = trunc i64 %x to i32
  ret i32 %trunc
